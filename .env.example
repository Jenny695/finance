# 复制为 .env，仅保存在本机。不要发送到聊天，不要提交 Git。
# 以下凭据必须由 iFinD 官方接口工具提供，客户端账号密码不能替代它们。
# 如无接口权限，直接在网页导入客户端导出的 CSV。
IFIND_REFRESH_TOKEN=
IFIND_ACCESS_TOKEN=
# 可选：你已核对的发行机构官方披露域名，逗号分隔，不带协议或路径。
PUBLIC_SOURCE_HOSTS=

# DeepSeek AI：仅存本机或托管平台 Secrets，不要发到聊天或上传 Git。
# 不配置密钥也可以使用新闻检索，AI解读会明确显示未开放。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# 可选：允许读取新闻正文的额外官方域名，逗号分隔；不带协议或路径。
NEWS_SOURCE_HOSTS=
