# Copy to .env.production on the server. Never commit or send real credentials.
# Host name only: no https:// prefix and no path. DNS must point to the server.
SITE_HOST=finance.your-domain.example
ADMIN_USERNAME=finance_admin
ADMIN_PASSWORD=REPLACE_WITH_YOUR_OWN_LONG_PASSWORD
IFIND_REFRESH_TOKEN=
IFIND_ACCESS_TOKEN=
PUBLIC_SOURCE_HOSTS=
USER_DAILY_QUERY_LIMIT=1000
TOTAL_DAILY_QUERY_LIMIT=1000
# Optional DeepSeek qualitative research. Set real key only on the server.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
NEWS_SOURCE_HOSTS=
